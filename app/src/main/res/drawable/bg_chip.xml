<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo dos chips de filtro (pílulas): laranja quando selecionado e cinza-escuro
     com borda quando não. O <selector> escolhe a forma pelo estado "selected" da View,
     então basta mudar chip.isSelected no código para trocar a aparência -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gh_laranja" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gh_superficie" />
            <stroke
                android:width="1dp"
                android:color="@color/gh_borda" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
