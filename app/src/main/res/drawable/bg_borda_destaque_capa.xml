<?xml version="1.0" encoding="utf-8"?>
<!-- Borda laranja de 2dp que aparece sobre a capa do card quando ele é tocado
     (variante "Pressionado" do Game Card no Figma). O miolo é transparente -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="2dp"
        android:color="@color/gh_laranja" />
    <corners android:radius="12dp" />
</shape>
