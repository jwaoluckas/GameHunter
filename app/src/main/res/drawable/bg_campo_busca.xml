<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do campo de busca da tela Principal (cantos de 16dp, como no Figma).
     Quando o campo está em foco (usuário digitando), a borda fica laranja. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gh_superficie" />
            <stroke
                android:width="1dp"
                android:color="@color/gh_laranja" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gh_superficie" />
            <stroke
                android:width="1dp"
                android:color="@color/gh_borda" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
