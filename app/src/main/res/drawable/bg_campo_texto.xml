<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo dos campos de texto (caixa cinza-escura com borda e cantos arredondados).
     O <selector> escolhe a aparência de acordo com o estado da View:
     quando o campo está em foco (usuário digitando), a borda fica laranja. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gh_superficie" />
            <stroke
                android:width="1dp"
                android:color="@color/gh_laranja" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gh_superficie" />
            <stroke
                android:width="1dp"
                android:color="@color/gh_borda" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
