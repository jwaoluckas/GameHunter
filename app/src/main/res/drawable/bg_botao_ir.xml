<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do botão "Ir" (abre a oferta na loja): vermelho, mais escuro quando pressionado -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gh_vermelho_escuro" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gh_vermelho" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
