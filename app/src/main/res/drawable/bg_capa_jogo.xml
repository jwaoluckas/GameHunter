<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo da área da capa do jogo no card.
     Enquanto a capa real não é carregada (ela virá da API), este degradê aparece no lugar.
     Os cantos arredondados também servem para "recortar" a imagem da capa (clipToOutline). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/gh_superficie_elevada"
        android:startColor="@color/gh_vermelho_escuro" />
    <corners android:radius="12dp" />
</shape>
