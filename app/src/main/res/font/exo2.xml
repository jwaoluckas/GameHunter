<?xml version="1.0" encoding="utf-8"?>
<!-- Família da fonte Exo 2 (usada no Figma do projeto).
     Junta os 3 pesos da fonte em uma só família: o Android escolhe o arquivo certo
     de acordo com o textStyle (normal = 400, bold = 700).
     Os atributos "app:" garantem compatibilidade com versões antigas do Android (antes da API 26). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/exo2_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/exo2_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/exo2_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/exo2_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/exo2_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/exo2_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/exo2_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/exo2_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

    <font
        android:font="@font/exo2_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/exo2_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
