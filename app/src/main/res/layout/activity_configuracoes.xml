<?xml version="1.0" encoding="utf-8"?>
<!-- Layout da tela de CONFIGURAÇÕES (usado pela ConfiguracoesActivity), seguindo o frame
     do Figma. A estrutura é a mesma do Cadastro: barra superior fixa e conteúdo rolável.
     fitsSystemWindows="true": evita que o conteúdo fique por baixo da barra de status -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_fundo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ===== BARRA SUPERIOR: botão voltar + título + ícone da logo ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_botao_voltar"
            android:contentDescription="@string/desc_voltar"
            android:scaleType="center"
            android:src="@drawable/ic_voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/menu_configuracoes"
            android:textColor="@color/gh_texto_primario"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/desc_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_gamehunter_icone" />
    </LinearLayout>

    <!-- ===== CONTEÚDO (rolável) ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <!-- ===== FOTO DE PERFIL: círculo com borda laranja que abre a galeria ===== -->
            <FrameLayout
                android:id="@+id/frameFoto"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_botao_perfil"
                android:contentDescription="@string/desc_alterar_foto">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_perfil" />

                <ImageView
                    android:id="@+id/imgFotoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_botao_perfil"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtAlterarFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/config_alterar_foto"
                android:textColor="@color/gh_laranja"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- ===== INFORMAÇÕES PESSOAIS: nome, e-mail e data de nascimento ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/exo2_semibold"
                android:text="@string/config_informacoes_pessoais"
                android:textColor="@color/gh_texto_primario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/rotulo_nome"
                android:textColor="@color/gh_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_campo_texto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_usuario" />

                <EditText
                    android:id="@+id/edtNome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="name"
                    android:background="@null"
                    android:hint="@string/hint_nome"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/gh_texto_primario"
                    android:textColorHint="@color/gh_texto_apagado"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rotulo_email"
                android:textColor="@color/gh_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_campo_texto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_email" />

                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="emailAddress"
                    android:background="@null"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/gh_texto_primario"
                    android:textColorHint="@color/gh_texto_apagado"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rotulo_data_nascimento"
                android:textColor="@color/gh_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_campo_texto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendario" />

                <EditText
                    android:id="@+id/edtDataNascimento"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/hint_data_nascimento"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:textColor="@color/gh_texto_primario"
                    android:textColorHint="@color/gh_texto_apagado"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ===== ALTERAR SENHA (opcional): nova senha e confirmação ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/exo2_semibold"
                android:text="@string/config_alterar_senha"
                android:textColor="@color/gh_texto_primario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/rotulo_nova_senha"
                android:textColor="@color/gh_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_campo_texto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cadeado" />

                <EditText
                    android:id="@+id/edtNovaSenha"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:hint="@string/hint_senha_nova"
                    android:inputType="textPassword"
                    android:textColor="@color/gh_texto_primario"
                    android:textColorHint="@color/gh_texto_apagado"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imgMostrarNovaSenha"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mostrar_senha"
                    android:padding="8dp"
                    android:src="@drawable/ic_olho" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rotulo_confirmar_nova_senha"
                android:textColor="@color/gh_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_campo_texto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cadeado" />

                <EditText
                    android:id="@+id/edtConfirmarSenha"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:hint="@string/hint_confirmar_senha"
                    android:inputType="textPassword"
                    android:textColor="@color/gh_texto_primario"
                    android:textColorHint="@color/gh_texto_apagado"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imgMostrarConfirmarSenha"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mostrar_senha"
                    android:padding="8dp"
                    android:src="@drawable/ic_olho" />
            </LinearLayout>

            <!-- ===== PREFERÊNCIAS: moeda padrão (chips) e alertas de promoção (switch) ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/exo2_semibold"
                android:text="@string/config_preferencias"
                android:textColor="@color/gh_texto_primario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/config_moeda_padrao"
                android:textColor="@color/gh_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flowMoedaPadrao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="8dp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalGap="8dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/exo2_medium"
                    android:labelFor="@id/swAlertasPromocao"
                    android:text="@string/config_alertas_promocao"
                    android:textColor="@color/gh_texto_primario"
                    android:textSize="14sp" />

                <!-- Switch com trilho e bolinha próprios (bg_switch_trilho e bg_switch_bolinha),
                     para ficar igual ao Figma -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAlertasPromocao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/config_alertas_promocao"
                    android:thumb="@drawable/bg_switch_bolinha"
                    app:track="@drawable/bg_switch_trilho" />
            </LinearLayout>

            <!-- ===== BOTÃO SALVAR ===== -->
            <Button
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_botao_primario"
                android:text="@string/config_salvar"
                android:textAllCaps="false"
                android:textColor="@color/gh_texto_primario"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
