<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de UMA fileira da tela Principal (item do RecyclerView rvFileiras):
     cabeçalho (título, subtítulo e "Ver tudo") + carrossel horizontal de cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:orientation="vertical">

    <!-- ===== CABEÇALHO DA FILEIRA ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloFileira"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gh_texto_primario"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloFileira"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/gh_texto_apagado"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtVerTudo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:text="@string/principal_ver_tudo"
            android:textColor="@color/gh_laranja"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== CARROSSEL DE CARDS =====
         RecyclerView horizontal com os jogos da fileira.
         clipToPadding="false" permite que os cards rolem até a borda da tela. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJogos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp" />
</LinearLayout>
