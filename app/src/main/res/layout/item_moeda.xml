<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de UMA moeda da lista do modal "Comparar moedas": código da moeda, região,
     tipo de preço, valor na moeda local e o valor convertido para a moeda padrão -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_linha_lista"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/txtCodigoMoeda"
        android:layout_width="48dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_codigo_moeda"
        android:gravity="center"
        android:textColor="@color/gh_laranja"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtRegiaoMoeda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/exo2_medium"
            android:textColor="@color/gh_texto_primario"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtTipoPreco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/exo2_medium"
            android:textColor="@color/gh_texto_apagado"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtValorMoeda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/exo2_extrabold"
            android:textColor="@color/gh_texto_primario"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtValorConvertido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/exo2_medium"
            android:textColor="@color/gh_texto_apagado"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
