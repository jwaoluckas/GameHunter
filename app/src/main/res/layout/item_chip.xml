<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de UM chip de filtro (pílula com texto). Usado nas listas horizontais de
     chips (tela Principal e Resultado de pesquisas) e nos grupos de chips dos modais.
     O fundo (bg_chip) e a cor do texto (texto_chip) mudam sozinhos conforme o chip
     está selecionado ou não (propriedade isSelected) -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/txtChip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_chip"
    android:fontFamily="@font/exo2_semibold"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp"
    android:textColor="@color/texto_chip"
    android:textSize="12sp" />
