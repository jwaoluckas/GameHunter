<?xml version="1.0" encoding="utf-8"?>
<!-- Layout da tela RESULTADO DE PESQUISAS (usado pela ResultadoPesquisaActivity),
     seguindo o frame do Figma: linha de busca, chips rápidos, contagem de resultados
     e a grade de cards em 2 colunas.
     fitsSystemWindows="true": evita que o conteúdo fique por baixo da barra de status -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_fundo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ===== LINHA DE BUSCA: voltar, campo de busca (com limpar) e filtros ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_botao_voltar"
            android:contentDescription="@string/desc_voltar"
            android:scaleType="center"
            android:src="@drawable/ic_voltar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:addStatesFromChildren="true"
            android:background="@drawable/bg_campo_busca"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_busca" />

            <EditText
                android:id="@+id/edtBusca"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/exo2_medium"
                android:hint="@string/hint_busca"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textColor="@color/gh_texto_primario"
                android:textColorHint="@color/gh_texto_apagado"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnLimpar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_limpar_busca"
                android:scaleType="center"
                android:src="@drawable/ic_limpar" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnFiltros"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_botao_filtros"
            android:contentDescription="@string/desc_filtros"
            android:scaleType="center"
            android:src="@drawable/ic_filtros" />
    </LinearLayout>

    <!-- ===== CHIPS RÁPIDOS (Todas, Em promoção, PS5...) em uma lista horizontal ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp" />

    <!-- ===== CONTAGEM DE RESULTADOS E ORDENAÇÃO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/txtContagem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/exo2_medium"
            android:maxLines="1"
            android:textColor="@color/gh_texto_secundario"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtOrdenar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:textColor="@color/gh_laranja"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== GRADE DE RESULTADOS =====
         FrameLayout empilha a grade e a mensagem de "nenhum resultado" (só uma aparece).
         O paddingEnd de 4dp somado à margem de 12dp à direita de cada card dá os
         mesmos 16dp de borda dos dois lados da tela -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvResultados"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtNenhumResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/resultado_nenhum"
            android:textColor="@color/gh_texto_secundario"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
