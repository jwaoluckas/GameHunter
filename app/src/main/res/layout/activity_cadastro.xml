<?xml version="1.0" encoding="utf-8"?>
<!-- Layout da tela de CADASTRO (usado pela CadastroActivity), seguindo o frame "Cadastro" do Figma.
     A raiz é um LinearLayout vertical com duas partes: a barra superior (fixa) e o conteúdo (que rola).
     fitsSystemWindows="true": evita que o conteúdo fique por baixo da barra de status (Edge-to-Edge). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_fundo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ===== BARRA SUPERIOR: botão voltar + título + ícone da logo ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_botao_voltar"
            android:contentDescription="@string/desc_voltar"
            android:scaleType="center"
            android:src="@drawable/ic_voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/cadastro_titulo"
            android:textColor="@color/gh_texto_primario"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/desc_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_gamehunter_icone" />
    </LinearLayout>

    <!-- ===== CONTEÚDO (rolável) =====
         layout_height="0dp" + layout_weight="1": ocupa toda a altura que sobra abaixo da barra. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- ===== FOTO DE PERFIL (opcional): círculo tracejado que abre a galeria ===== -->
            <FrameLayout
                android:id="@+id/frameFoto"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_foto_perfil"
                android:contentDescription="@string/desc_adicionar_foto">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camera" />

                <ImageView
                    android:id="@+id/imgFotoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_foto_perfil"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtAdicionarFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/cadastro_adicionar_foto"
                android:textColor="@color/gh_laranja"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- ===== Campo NOME ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rotulo_nome"
                android:textColor="@color/gh_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_campo_texto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_usuario" />

                <EditText
                    android:id="@+id/edtNome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="name"
                    android:background="@null"
                    android:hint="@string/hint_nome"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/gh_texto_primario"
                    android:textColorHint="@color/gh_texto_apagado"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ===== Campo E-MAIL ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rotulo_email"
                android:textColor="@color/gh_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_campo_texto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_email" />

                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="emailAddress"
                    android:background="@null"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/gh_texto_primario"
                    android:textColorHint="@color/gh_texto_apagado"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ===== Campo SENHA ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rotulo_senha"
                android:textColor="@color/gh_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_campo_texto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cadeado" />

                <EditText
                    android:id="@+id/edtSenha"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:hint="@string/hint_senha_nova"
                    android:inputType="textPassword"
                    android:textColor="@color/gh_texto_primario"
                    android:textColorHint="@color/gh_texto_apagado"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imgMostrarSenha"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mostrar_senha"
                    android:padding="8dp"
                    android:src="@drawable/ic_olho" />
            </LinearLayout>

            <!-- ===== Campo CONFIRMAR SENHA ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rotulo_confirmar_senha"
                android:textColor="@color/gh_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_campo_texto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cadeado" />

                <EditText
                    android:id="@+id/edtConfirmarSenha"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:hint="@string/hint_confirmar_senha"
                    android:inputType="textPassword"
                    android:textColor="@color/gh_texto_primario"
                    android:textColorHint="@color/gh_texto_apagado"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imgMostrarConfirmarSenha"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mostrar_senha"
                    android:padding="8dp"
                    android:src="@drawable/ic_olho" />
            </LinearLayout>

            <!-- ===== Campo DATA DE NASCIMENTO ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rotulo_data_nascimento"
                android:textColor="@color/gh_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_campo_texto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendario" />

                <EditText
                    android:id="@+id/edtDataNascimento"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/hint_data_nascimento"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:textColor="@color/gh_texto_primario"
                    android:textColorHint="@color/gh_texto_apagado"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ===== BOTÃO CRIAR CONTA E LINK "JÁ TEM CONTA? ENTRAR" ===== -->
            <Button
                android:id="@+id/btnCriarConta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_botao_primario"
                android:text="@string/cadastro_botao_criar_conta"
                android:textAllCaps="false"
                android:textColor="@color/gh_texto_primario"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/linkEntrar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cadastro_ja_tem_conta"
                    android:textColor="@color/gh_texto_secundario"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/cadastro_entrar"
                    android:textColor="@color/gh_laranja"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
